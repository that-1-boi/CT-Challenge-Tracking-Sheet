# Supabase Configuration
# Get these values from your Supabase project dashboard:
# Settings → API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (NOT the service_role key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here


# ============================================
# SETUP INSTRUCTIONS
# ============================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get your Supabase credentials:
#    - Go to https://supabase.com
#    - Open your project
#    - Settings → API
#    - Copy "Project URL" and "anon public" key
#
# 3. Replace the values above in your .env file
#
# 4. For Vercel deployment:
#    - Go to your Vercel project
#    - Settings → Environment Variables
#    - Add both variables
#    - Enable for all environments
#    - Redeploy
#
# ============================================
# IMPORTANT
# ============================================
#
# ⚠️ NEVER commit .env to Git!
# ⚠️ Use anon public key (not service_role)
# ⚠️ Variables must start with VITE_ for Vite
#
